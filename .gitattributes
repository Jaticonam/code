# Política canónica de texto del repositorio.
# Git conserva LF en el índice y aplica excepciones explícitas por plataforma.
* text=auto

# Código y configuración multiplataforma.
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf
*.json        text eol=lf
*.css         text eol=lf
*.scss        text eol=lf
*.html        text eol=lf
*.svg         text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.csv         text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sh          text eol=lf
*.env         text eol=lf
.env*         text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# Scripts ejecutados directamente en Windows.
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Imágenes y documentos binarios.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.avif        binary
*.ico         binary
*.pdf         binary

# Audio y video.
*.mp3         binary
*.wav         binary
*.ogg         binary
*.mp4         binary
*.webm        binary
*.mov         binary

# Fuentes y archivos comprimidos.
*.woff        binary
*.woff2       binary
*.ttf         binary
*.otf         binary
*.zip         binary
*.gz          binary
*.7z          binary
